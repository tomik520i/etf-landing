# Vzor konfigurace. Zkopíruj na .env (mimo document root) a vyplň.
# .env se NIKDY necommituje.

# MariaDB (na serveru .200, jen localhost)
DB_HOST=127.0.0.1
DB_NAME=etf_lp
DB_USER=etf_lp
DB_PASS=

# Resend (HTTP API, https://resend.com/docs/api-reference/emails/send-email)
# API klíč = totéž, co Resend ukazuje jako SMTP heslo
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# Veřejná adresa webu (odkazy v e-mailu)
APP_URL=https://aijunior.opicebot.cz
# Náhodný řetězec pro podpis odhlašovacích odkazů: openssl rand -hex 32
APP_SECRET=

# Admin funnel chrání basic auth v Apache (deploy/INSTALL.md, krok 5), ne PHP.

# CORS – origin GitHub Pages zrcadla
CORS_ORIGIN=https://UZIVATEL.github.io
